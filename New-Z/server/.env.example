# Copy this file to .env and fill in real values before running the server

PORT=4000

# The email address that receives quote requests
TO_EMAIL=shaikgousebasha8008@gmail.com

# SMTP credentials used to SEND the email (not the recipient).
# For Gmail: use smtp.gmail.com, port 587, and a 16-character App Password
# (not your regular Gmail password - generate one at myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-char-app-password
