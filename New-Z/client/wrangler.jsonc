{
  "name": "zulfi-tech-site",
  "compatibility_date": "2026-01-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Custom domains (previously set only in the dashboard; kept here so deploys never drop them).
  "routes": [
    { "pattern": "zulfi-tech.com", "custom_domain": true },
    { "pattern": "www.zulfi-tech.com", "custom_domain": true }
  ],
  // ADMIN_SEED_SECRET (portal admin key) is an encrypted secret: `npx wrangler secret put ADMIN_SEED_SECRET`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zulfitech-portal",
      "database_id": "a1c10908-19a1-45b2-9e37-7261874db95a"
    }
  ]
}
